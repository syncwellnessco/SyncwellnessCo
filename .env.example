# Supabase Configuration
# Found in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Site URL (for Stripe redirects and SEO)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudinary Configuration
# Found in Cloudinary Dashboard
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name

# Cloudinary Upload Presets (Unsigned)
# Found in Cloudinary Settings -> Upload -> Upload presets
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_upload_preset
NEXT_PUBLIC_CLOUDINARY_PRESET_VIDEOS=your_video_preset
NEXT_PUBLIC_CLOUDINARY_PRESET_REVIEWS=your_reviews_preset
NEXT_PUBLIC_CLOUDINARY_PRESET_PROGRAMS=your_programs_preset
NEXT_PUBLIC_CLOUDINARY_PRESET_BLOGS=your_blogs_preset

# Cloudinary Admin API Keys (Required for deleting orphaned files)
# Found in Cloudinary Dashboard -> Settings -> Access Keys
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Mailerlite API Keys
# Found in Mailerlite Dashboard -> Integrations -> API
MAILERLITE_API_KEY=your_mailerlite_api_key_here
MAILERLITE_GROUP_ID=your_mailerlite_group_id_here

# Course-Specific Group IDs (Buyer is subscribed ONLY if the matching key has a group ID)
MAILERLITE_GROUP_PROGRAM_ENROLLMENT=your_program_enrollment_group_id_here

# Stripe Configuration
# Found in Stripe Dashboard -> Developers -> API keys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Calendly Configuration
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-username/your-event
CALENDLY_API_KEY=your_calendly_personal_access_token_here
CALENDLY_WEBHOOK_SIGNING_KEY=your_calendly_webhook_signing_key_here

