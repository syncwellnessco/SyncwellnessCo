# Supabase Configuration
# Found in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Site URL (for Stripe redirects and SEO)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare R2 Configuration (Server-Side)
# Found in Cloudflare Dashboard -> R2 -> Manage R2 API Tokens / Overview
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name

# Cloudflare R2 Public Media URL (CDN / Custom Domain or Public Bucket URL)
# Example: https://media.syncwellness.co or https://pub-xxxxxxxxxxxx.r2.dev
R2_PUBLIC_URL=https://media.syncwellness.co
NEXT_PUBLIC_R2_PUBLIC_URL=https://media.syncwellness.co


# Mailerlite API Keys
# Found in Mailerlite Dashboard -> Integrations -> API
MAILERLITE_API_KEY=your_mailerlite_api_key_here
MAILERLITE_GROUP_EBOOK=your_mailerlite_ebook_group_id_here

# Course-Specific Group IDs (Buyer is subscribed ONLY if the matching key has a group ID)
MAILERLITE_GROUP_PROGRAM_ENROLLMENT=your_program_enrollment_group_id_here

# Stripe Configuration
# Found in Stripe Dashboard -> Developers -> API keys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Calendly Configuration
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-username/your-event
CALENDLY_API_KEY=your_calendly_personal_access_token_here
CALENDLY_WEBHOOK_SIGNING_KEY=your_calendly_webhook_signing_key_here

